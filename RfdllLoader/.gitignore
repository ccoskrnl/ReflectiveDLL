# Build outputs of the loader shellcode (build.cmd + objcopy).
# *.obj, *.pdb, *.ilk and *.log are already covered by the repository .gitignore.
loader.bin
loader.exe
loader_packed.bin
loader_packed.exe
loader_exec.bin
loader_exec.exe

# Build outputs of the end to end test (test/build_test.cmd).
test/*.dll
test/*.exe
test/*.lib
test/*.exp

# Scratch directories of test/test_pack.py (also leftovers of a failed run).
test/packtest_*/

# Default outputs of pack.py when it is run from this directory.
payload.bin
payload_info.json
